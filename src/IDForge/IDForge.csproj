<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="IDForge.Tests" />
    <ProjectReference Include="..\IDForge.Core\IDForge.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.3</Version>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <FileVersion>1.2.3.0</FileVersion>
    <InformationalVersion>1.2.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="..\..\assets\fonts\Inter-Regular.ttf" Link="Fonts\Inter-Regular.ttf" />
    <Resource Include="..\..\assets\fonts\Inter-Medium.ttf" Link="Fonts\Inter-Medium.ttf" />
    <Resource Include="..\..\assets\fonts\Inter-SemiBold.ttf" Link="Fonts\Inter-SemiBold.ttf" />
    <Resource Include="..\..\assets\fonts\JetBrainsMono-Regular.ttf" Link="Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="..\..\assets\fonts\fa-solid-900.ttf" Link="Fonts\fa-solid-900.ttf" />
    <None Include="..\..\assets\fonts\OFL-Inter.txt" Link="Fonts\OFL-Inter.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\OFL-JetBrainsMono.txt" Link="Fonts\OFL-JetBrainsMono.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\OFL-FontAwesome.txt" Link="Fonts\OFL-FontAwesome.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
