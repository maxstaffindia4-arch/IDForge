<Window x:Class="IDForge.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IDForge.Core;assembly=IDForge.Core"
        Title="Batch Review" Width="1180" Height="780" FontFamily="{StaticResource AppFontFamily}"
        Icon="pack://application:,,,/IDForge;component/app.ico"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left: row list + filter -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="6">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <ComboBox x:Name="CmbFilter" Width="130" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Needs review"/>
                    <ComboBoxItem Content="Failed"/>
                    <ComboBoxItem Content="Issued"/>
                    <ComboBoxItem Content="Skipped"/>
                </ComboBox>
            </StackPanel>
            <ListBox x:Name="LstRows" MouseDoubleClick="Row_DoubleClick"
                     SelectionChanged="Row_Selected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ReviewLabel}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ReviewLabel}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Center: full card preview -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
            <Grid ClipToBounds="True">
                <Image x:Name="ImgPreview" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TxtPreviewHint" Text="No card to preview"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Right: fields + photo panel -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="6">
            <StackPanel>
                <TextBlock Text="Full name" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtName" TextChanged="Field_Changed" MaxLength="40"/>
                <TextBlock x:Name="ErrName" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="Blood group" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="CmbBlood" SelectionChanged="Field_Changed"
                          ItemsSource="{Binding Source={x:Static core:Config.BloodGroups}}"/>

                <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="CmbPosition" SelectionChanged="Field_Changed"
                          ItemsSource="{Binding Source={x:Static core:Config.Positions}}"/>
                <TextBlock x:Name="ErrPosition" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="UID" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtUid" TextChanged="Field_Changed" LostFocus="Uid_LostFocus"/>
                <TextBlock x:Name="ErrUid" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="Contract type" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="CmbContract" SelectionChanged="Field_Changed"
                          ItemsSource="{Binding Source={x:Static core:Config.ContractTypes}}"/>

                <TextBlock Text="Print date" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <DatePicker x:Name="DpPrintDate" SelectedDateChanged="Field_Changed"/>
                <TextBlock x:Name="ErrPrintDate" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="Photo" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtPhoto" IsReadOnly="True" Width="230"/>
                    <Button Content="Replace..." Margin="6,0,0,0" Click="BrowsePhoto_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Background:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbBgMode" Width="180" Margin="8,0,0,0"
                              SelectionChanged="BgMode_Changed">
                        <ComboBoxItem Content="Plain white" Tag="PlainWhite"/>
                        <ComboBoxItem Content="Model" Tag="Model"/>
                        <ComboBoxItem Content="Keep as is" Tag="Keep"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="TxtPhotoStatus" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <GroupBox Header="Photo position" Margin="0,10,0,0" IsEnabled="False" x:Name="GrpNudge">
                    <StackPanel Margin="6">
                        <TextBlock Text="Zoom (× auto)"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldZoom" Width="200" Minimum="0.4" Maximum="3.0" Value="1"
                                    TickFrequency="0.05" ValueChanged="Nudge_Changed"/>
                            <TextBox x:Name="TxtZoom" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                     Text="1" TextChanged="NudgeText_Changed" Tag="zoom"/>
                        </StackPanel>
                        <TextBlock Text="Horizontal (px)"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldX" Width="200" Minimum="-320" Maximum="320" Value="0"
                                    TickFrequency="5" ValueChanged="Nudge_Changed"/>
                            <TextBox x:Name="TxtX" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                     Text="0" TextChanged="NudgeText_Changed" Tag="x"/>
                        </StackPanel>
                        <TextBlock Text="Vertical (px)"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldY" Width="200" Minimum="-400" Maximum="400" Value="0"
                                    TickFrequency="5" ValueChanged="Nudge_Changed"/>
                            <TextBox x:Name="TxtY" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                     Text="0" TextChanged="NudgeText_Changed" Tag="y"/>
                        </StackPanel>
                        <Button Content="Reset to auto" Click="ResetNudge_Click" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="6,0,6,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="◄ Previous" Click="Prev_Click" Margin="4"/>
                    <Button Content="Save draft" Click="SaveDraft_Click" Margin="4"/>
                    <Button Content="Skip" Click="Skip_Click" Margin="4"/>
                    <Button Content="Approve" x:Name="BtnApprove" Style="{StaticResource PrimaryButton}" Click="Approve_Click" Margin="4"/>
                    <Button Content="Issue card" x:Name="BtnIssue" Style="{StaticResource PrimaryButton}" Click="Issue_Click" Margin="4"/>
                    <Button Content="Batch Issue" x:Name="BtnBatchIssue" Click="BatchIssue_Click"
                            Margin="12,4,4,4" FontWeight="SemiBold" Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed"/>
                    <Button Content="Next ►" Click="Next_Click" Margin="4"/>
                    <TextBlock Text="Issue options (confirm before issue, PDF) are set in Settings on the main window."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="16,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
