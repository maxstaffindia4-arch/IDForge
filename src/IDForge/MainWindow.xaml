<Window x:Class="IDForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IDForge.Core;assembly=IDForge.Core"
        xmlns:controls="clr-namespace:IDForge.Controls"
        Language="en-GB"
        Title="IDForge — New card" Width="1100" Height="760" FontFamily="{StaticResource AppFontFamily}"
        Icon="pack://application:,,,/IDForge;component/app.ico"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BatchCellFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatchCell" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BatchCellFocus}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <!-- No template focus rectangles: the blue FocusVisualStyle
                             ring is the only focus indicator (also in selected rows). -->
                        <Border Padding="4,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Left-nav item: light blue background when checked; blue ring only on keyboard focus -->
        <!-- Keyboard-only focus ring: WPF shows FocusVisualStyle only after
             keyboard navigation, never after a mouse click. -->
        <!-- Must target Control: WPF's FocusVisualAdorner applies this style to
             an internal Control, so a narrower TargetType crashes on keyboard focus. -->
        <Style x:Key="NavFocusRing" TargetType="Control">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                                CornerRadius="6" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Parity plan §4.2: selected = accent fill + 3 px left bar;
             focus ring stays keyboard-only via NavFocusRing. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" Margin="0,8,0,8"
                                    CornerRadius="0,2,2,0"
                                    Background="{StaticResource PrimaryBrush}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FIX 4: same look as NavItem but for action buttons (Help, About)
             — no checked state. -->
        <Style x:Key="NavAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented contract-type choice (Permanent / Contractual) -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,8"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview zoom selector (Fit / 100% / 200%) -->
        <Style x:Key="ZoomButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== Batch grid styles (§2.5-2.7) ===== -->
        <Style x:Key="BatchHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style x:Key="BatchRow" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                    <Setter Property="BorderBrush" Value="#663B82F6"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Always-visible grid input: 1 px InputBrush border, 32 px row height. -->
        <Style x:Key="GridInput" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== Batch filter chips (§2.4) ===== -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Background="{StaticResource BackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChipAttention" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="Background" Value="#0DEF4444"/>
        </Style>
        <Style x:Key="FilterChipReissue" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderBrush" Value="#66D97706"/>
            <Setter Property="Background" Value="#0DD97706"/>
        </Style>
    </Window.Resources>
    <!-- FIX 4: menu bar removed entirely — shortcuts keep working,
         Help/About live in the nav rail. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- Both children share the single cell: NavCol floats over
                 PagesHost (Panel.ZIndex) instead of sitting in a column.
                 A zero-width column used to clip NavCol to 0 px — WPF's
                 layout clip follows the arrange slot, not the explicit
                 Width — which is why the rail rendered empty. -->

            <!-- ============ LEFT NAV ============ -->
            <Border x:Name="NavCol" Width="208" Panel.ZIndex="5"
                    HorizontalAlignment="Left"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12">
                    <!-- FIX 3: visible rail toggle at all sizes (menu bar is gone) -->
                    <Button x:Name="BtnNavToggle" DockPanel.Dock="Top"
                            Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                            HorizontalAlignment="Right" Margin="0,0,12,4"
                            FontFamily="{StaticResource IconFont}" FontSize="12"
                            Content="&#xF053;" ToolTip="Collapse navigation"
                            Click="NavToggle_Click"/>
                    <!-- Backup card: full when expanded, shield icon when collapsed (§4.1) -->
                    <Border x:Name="PnlBackupFull" DockPanel.Dock="Bottom" Margin="12,8" Padding="12" CornerRadius="4"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF3ED;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Backed up" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLastBackup" Text="Never" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtBackupAgeWarn" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                            <Button Content="Back up now" Style="{StaticResource SecondaryButton}"
                                    Height="28" Margin="0,8,0,0" Padding="12,0" FontSize="12"
                                    Click="NavBackup_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PnlBackupCompact" DockPanel.Dock="Bottom" Margin="10,8" Width="40" Height="36"
                            Padding="0" HorizontalAlignment="Center"
                            Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Cursor="Hand" Visibility="Collapsed"
                            ToolTip="Last backup. Back up now"
                            MouseLeftButtonUp="NavBackup_Click">
                        <TextBlock Text="&#xF3ED;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- FIX 4: Help + About sit directly above the backup card -->
                    <StackPanel x:Name="PnlNavHelpAbout" DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Button x:Name="NavHelp" Style="{StaticResource NavAction}"
                                Click="NavHelp_Click" ToolTip="Help (F1)">
                            <Grid x:Name="NavPnlHelp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF059;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblHelp" Grid.Column="1" Text="Help"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavKeyHelp" Grid.Column="2" Text="F1" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NavAbout" Style="{StaticResource NavAction}"
                                Click="NavAbout_Click" ToolTip="About IDForge">
                            <Grid x:Name="NavPnlAbout">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF05A;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblAbout" Grid.Column="1" Text="About"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="PnlNavItems" Margin="0">
                        <TextBlock x:Name="LblIssueCards" Text="ISSUE CARDS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="16,0,0,8"/>
                        <Border x:Name="DvdIssueCards" Height="1" Margin="12,12"
                                Background="{StaticResource BorderBrush}" Visibility="Collapsed"/>
                        <RadioButton x:Name="NavNewCard" Style="{StaticResource NavItem}" GroupName="nav"
                                     IsChecked="True" Click="NavNewCard_Click" ToolTip="New card (Ctrl+1)">
                            <Grid x:Name="NavPnlNewCard">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF2C2;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblNewCard" Grid.Column="1" Text="New card"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavKeyNewCard" Grid.Column="2" Text="Ctrl+1" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavBatch" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavBatch_Click" ToolTip="Batch (Ctrl+2)">
                            <Grid x:Name="NavPnlBatch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF5FD;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblBatch" Grid.Column="1" Text="Batch"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavKeyBatch" Text="Ctrl+2" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                    <Border x:Name="NavBatchBadge" CornerRadius="9" MinWidth="18" Height="18"
                                            Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{StaticResource SecondaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="TxtNavBatchCount" Text="0" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <TextBlock x:Name="LblManage" Text="MANAGE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="16,12,0,8"/>
                        <Border x:Name="DvdManage" Height="1" Margin="12,12"
                                Background="{StaticResource BorderBrush}" Visibility="Collapsed"/>
                        <RadioButton x:Name="NavRecords" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavRecords_Click" ToolTip="Records (Ctrl+3)">
                            <Grid x:Name="NavPnlRecords">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF07C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblRecords" Grid.Column="1" Text="Records"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavKeyRecords" Grid.Column="2" Text="Ctrl+3" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavSettings_Click" ToolTip="Settings (Ctrl+,)">
                            <Grid x:Name="NavPnlSettings">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xF013;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblSettings" Grid.Column="1" Text="Settings"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavKeySettings" Grid.Column="2" Text="Ctrl+," FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ PAGES ============ -->
            <Grid x:Name="PagesHost">

                <!-- ===== NEW CARD ===== -->
                <Grid x:Name="PageNewCard">
                    <Grid.Resources>
                        <!-- Parity plan §5.2/5.3 — New-card-only styles. SecondaryButton is
                             re-declared locally (spec values) so the shared theme used by
                             Batch/Records/Settings is untouched. -->
                        <Style x:Key="SecondaryButton" TargetType="Button">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource SecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

                        <!-- §5.3 field input: 36 px, 4 px radius, 2 px halo on keyboard focus -->
                        <Style x:Key="FieldInput" TargetType="TextBox">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="{StaticResource InputBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border x:Name="Halo" CornerRadius="6" BorderThickness="2"
                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                    Opacity="0.2" Visibility="Collapsed"/>
                                            <Border x:Name="Bd" CornerRadius="4"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Padding="{TemplateBinding Padding}"
                                                              VerticalContentAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Halo" Property="Visibility"
                                                        Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- UID variant: JetBrains Mono, right-side rounding for the
                             prefix/suffix compound field (no halo on the shared edge). -->
                        <Style x:Key="FieldInputMono" TargetType="TextBox"
                               BasedOn="{StaticResource FieldInput}">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border x:Name="Halo" CornerRadius="0,6,6,0"
                                                    BorderThickness="0,2,2,2"
                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                    Opacity="0.2" Visibility="Collapsed"/>
                                            <Border x:Name="Bd" CornerRadius="0,4,4,0"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Padding="{TemplateBinding Padding}"
                                                              VerticalContentAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Halo" Property="Visibility"
                                                        Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- §5.4 preview zoom group button -->
                        <Style x:Key="ZoomGroupButton" TargetType="Button">
                            <Setter Property="Width" Value="28"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource SecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- §5.4/5.5 design checkbox: 14 px box, FA check when on -->
                        <Style x:Key="DesignCheckBox" TargetType="CheckBox">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Box" Width="14" Height="14"
                                                    CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Chk" Text="&#xF00C;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="9" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter Margin="8,0,0,0"
                                                              VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="Background"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Box" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Chk" Property="Visibility"
                                                        Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- §5.3 contract segmented control option -->
                        <Style x:Key="SegOption" TargetType="RadioButton">
                            <Setter Property="Height" Value="48"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource BackgroundBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource BorderBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness"
                                                        Value="1"/>
                                                <Setter TargetName="Bd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Opacity="0.1" BlurRadius="2"
                                                                          ShadowDepth="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource PanelLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page header (§5.1) -->
                    <Grid Grid.Row="0" Margin="24,20,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="New card" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Fill in the employee's details, adjust the photo, then issue the card."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel x:Name="PnlDraftNote" Orientation="Horizontal" Margin="0,0,12,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="&#xF0C7;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDraftNote" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="Clear form" Click="ClearForm_Click" Margin="0,0,8,0"/>
                            <!-- FIX 4: Save draft button removed — edits autosave. -->
                        </StackPanel>
                    </Grid>

                    <!-- §2 responsive columns: ≥1280 px → form(360) · preview(*) ·
                         photo(330); below → form+photo stacked in the left column,
                         preview on the right. No sideways page scroll. -->
                    <Grid x:Name="ColsNewCard" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== 1 · EMPLOYEE DETAILS (§5.3) ===== -->
                            <ScrollViewer x:Name="ScrollLeft" Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                <StackPanel Margin="12,0,12,12">
                                    <!-- Step heading: numbered circle + title + status icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                Background="{StaticResource PrimaryBrush}">
                                            <TextBlock Text="1" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Employee details" FontSize="14"
                                                   FontWeight="SemiBold" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ChkDetails" Text="&#xF058;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,6">
                                        <Run Text="Full name"/><Run Text=" *"
                                            Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <TextBox x:Name="TxtName" Style="{StaticResource FieldInput}"
                                             TextChanged="Field_Changed" MaxLength="40"/>
                                    <TextBlock x:Name="TxtNameHint" Text="Mixed capitals, check spelling"
                                               FontSize="11" Foreground="{StaticResource WarningBrush}"
                                               Margin="0,2,0,0" Visibility="Collapsed"/>

                                    <TextBlock FontSize="12" FontWeight="Medium"
                                               Margin="0,16,0,6">
                                        <Run Text="Position"/><Run Text=" *"
                                            Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <ComboBox x:Name="CmbPosition" Height="36"
                                              SelectionChanged="Field_Changed"/>

                                    <!-- Employee ID: label row carries the digit counter -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" FontWeight="Medium"
                                                   Margin="0,0,0,6">
                                            <Run Text="Employee ID"/><Run Text=" *"
                                                Foreground="{StaticResource ErrorBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtUidCount" Grid.Column="1"
                                                   Text="0 / 15" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </Grid>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4,0,0,4"
                                                Background="{StaticResource SecondaryBrush}"
                                                BorderBrush="{StaticResource InputBrush}"
                                                BorderThickness="1,1,0,1">
                                            <TextBlock Text="UID" FontSize="12" FontWeight="Medium"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                        <TextBox x:Name="TxtUid" Grid.Column="1"
                                                 Style="{StaticResource FieldInputMono}"
                                                 MaxLength="15"
                                                 PreviewTextInput="Uid_PreviewTextInput"
                                                 TextChanged="Uid_TextChanged"
                                                 LostFocus="Uid_LostFocus"
                                                 ToolTip="Numbers only, 4–15 digits. Don't type UID — it's added to the card for you."/>
                                        <TextBlock x:Name="IcoUidOk" Grid.Column="2" Text="&#xF058;"
                                                   FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="Numbers only, 4–15 digits. Don't type “UID” — it's added to the card for you."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ErrUid" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="LnkOpenRecord" FontSize="11" Margin="0,2,0,0"
                                               Visibility="Collapsed">
                                        <Hyperlink Click="OpenRecord_Click"
                                                   Foreground="{StaticResource PrimaryBrush}">Open record</Hyperlink>
                                    </TextBlock>

                                    <!-- Blood group + Print date side by side -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Blood group" FontSize="12"
                                                       FontWeight="Medium" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CmbBlood" Height="36"
                                                      SelectionChanged="Field_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="12" FontWeight="Medium"
                                                       Margin="0,0,0,6">
                                                <Run Text="Print date"/><Run Text=" *"
                                                    Foreground="{StaticResource ErrorBrush}"/>
                                            </TextBlock>
                                            <DatePicker x:Name="DpPrintDate" Height="36"
                                                        SelectedDateChanged="Field_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock FontSize="12" FontWeight="Medium"
                                               Margin="0,16,0,6">
                                        <Run Text="Contract type"/><Run Text=" *"
                                            Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="4">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="RadContractPerm" GroupName="Contract"
                                                         Style="{StaticResource SegOption}" IsChecked="True"
                                                         Checked="Field_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Permanent" FontSize="13"
                                                               FontWeight="Medium"/>
                                                    <TextBlock Text="Valid 12 months" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadContractContract" GroupName="Contract"
                                                         Style="{StaticResource SegOption}"
                                                         Checked="Field_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Contractual" FontSize="13"
                                                               FontWeight="Medium"/>
                                                    <TextBlock Text="Valid 6 months" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Validity box (§5.3) -->
                                    <Border Margin="0,16,0,0" Background="{StaticResource PanelLightBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF274;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtValidity" FontSize="13"
                                                       TextWrapping="Wrap"><Run x:Name="RunValidityLead" FontSize="12" Foreground="{StaticResource MutedBrush}"/><Run x:Name="RunValidUntil" FontWeight="SemiBold"/><Run x:Name="RunValiditySep"/><Run x:Name="RunValidMonths" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- §2: below 1280 px the photo panel stacks under the form here -->
                                <Grid x:Name="HostPhotoNarrow" Margin="12,0,12,12"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ===== LIVE PREVIEW (§5.4) ===== -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- FIX 2: MinHeight (not fixed 44) so the controls
                                     can drop to a second line at narrow widths. -->
                                <Border x:Name="PnlPreviewHeader" MinHeight="44" Padding="20,4"
                                        Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        SizeChanged="PreviewHeader_SizeChanged">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="PnlPreviewTitle" Grid.Row="0" Grid.Column="0"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLivePreview" Text="Live preview"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="PnlLiveBadge" Margin="8,0,0,0" Padding="8,2"
                                                    CornerRadius="10"
                                                    Background="{StaticResource AccentBrush}">
                                                <TextBlock Text="Updates as you type" FontSize="11"
                                                           Foreground="{StaticResource AccentTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- checkbox + Fit controls; wraps to row 1 when
                                             the header is too narrow (code-behind) -->
                                        <StackPanel x:Name="PnlPreviewControls" Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkPrintEdges" Content="Show print edges"
                                                      Style="{StaticResource DesignCheckBox}"
                                                      Margin="0,0,16,0"
                                                      Checked="PrintEdges_Changed"
                                                      Unchecked="PrintEdges_Changed"/>
                                            <Button x:Name="BtnZoomOut" Style="{StaticResource ZoomGroupButton}"
                                                    Content="&#xF068;" FontFamily="{StaticResource IconFont}"
                                                    ToolTip="Zoom out" Click="PreviewZoomOut_Click"/>
                                            <Button x:Name="BtnZoomFit" Style="{StaticResource ZoomGroupButton}"
                                                    Content="Fit" Width="48" Margin="-1,0,0,0"
                                                    ToolTip="Fit card to pane" Click="PreviewZoomFit_Click"/>
                                            <Button x:Name="BtnZoomIn" Style="{StaticResource ZoomGroupButton}"
                                                    Content="&#xF067;" FontFamily="{StaticResource IconFont}"
                                                    ToolTip="Zoom in" Margin="-1,0,0,0"
                                                    Click="PreviewZoomIn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="PreviewArea" Grid.Row="1" Margin="12,0,12,4"
                                        CornerRadius="6" Background="{StaticResource PanelBrush}"
                                        Focusable="True" AllowDrop="True"
                                        Drop="Preview_Drop" DragOver="Preview_DragOver"
                                        PreviewKeyDown="Preview_KeyDown"
                                        PreviewMouseWheel="Preview_MouseWheel"
                                        SizeChanged="PreviewArea_SizeChanged">
                                    <Grid>
                                        <ScrollViewer x:Name="PreviewScroll"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto">
                                            <Grid MinWidth="{Binding ViewportWidth, ElementName=PreviewScroll}"
                                                  MinHeight="{Binding ViewportHeight, ElementName=PreviewScroll}">
                                                <Grid HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Image x:Name="ImgPreview" Stretch="Uniform">
                                                        <Image.Effect>
                                                            <DropShadowEffect BlurRadius="24"
                                                                              ShadowDepth="6"
                                                                              Opacity="0.25"/>
                                                        </Image.Effect>
                                                    </Image>
                                                    <!-- 2 px ring, 30 % opacity, 4 px off the card edge -->
                                                    <Rectangle x:Name="RctCardRing" Margin="-6"
                                                               Stroke="{StaticResource PrimaryBrush}"
                                                               StrokeThickness="2" Opacity="0.3"
                                                               IsHitTestVisible="False"/>
                                                    <!-- dashed trim line; preview only, never saved -->
                                                    <Rectangle x:Name="RctPrintEdges" Margin="1"
                                                               Stroke="{StaticResource MutedBrush}"
                                                               StrokeThickness="1"
                                                               StrokeDashArray="4,3"
                                                               Visibility="Collapsed"
                                                               IsHitTestVisible="False"/>
                                                </Grid>
                                            </Grid>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtPreviewHint" Text="Preview appears here"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xF545;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Printed size 54 × 86 mm" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Width="4" Height="4"
                                                 Fill="{StaticResource BorderBrush}"
                                                 Margin="12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xF03E;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPrintFormat" FontSize="12"
                                                   Text="Print-quality image"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Click the photo and use the arrow keys to move it."
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ===== 2 · PHOTO (§5.5) ===== -->
                            <Grid x:Name="HostPhotoWide" Grid.Column="2">
                            <ScrollViewer x:Name="ScrollPhoto" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlPhotoBody" Margin="12,0,12,12">
                                    <!-- Step heading: numbered circle + title + status icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                Background="{StaticResource PrimaryBrush}">
                                            <TextBlock Text="2" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Photo" FontSize="14" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ChkPhoto" Text="&#xF058;"
                                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- Photo file card -->
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Change…"
                                                    Height="28" Click="BrowsePhoto_Click"
                                                    Padding="12,0" FontSize="12"/>
                                            <Border Width="40" Height="48" CornerRadius="4"
                                                    ClipToBounds="True" Margin="0,0,12,0"
                                                    Background="{StaticResource WhiteBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Image x:Name="ImgPhotoThumb" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtPhotoName" Text="No photo chosen"
                                                           FontSize="12" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtPhotoMeta" Text=""
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="Ctrl+O to choose a photo, or drag one onto the preview."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>

                                    <controls:PhotoPositionPanel x:Name="PosPanel" Margin="0,12,0,0"/>

                                    <TextBlock x:Name="TxtPhotoStatus"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Grid>

                    <!-- ===== FOOTER: issue bar (§6) ===== -->
                    <Border x:Name="PnlIssueBar" Grid.Row="2" Padding="24,12" Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- FIX 2: col0 is star-sized so the WrapPanel is
                                     width-constrained and wraps instead of pushing
                                     the Issue card off-window. Col1 is a zero-width
                                     spacer — giving it star share halved the space
                                     the chips actually get. -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- chips: check icon + plain text, no pill borders.
                                 WrapPanel (FIX 2): chips wrap to a second line at
                                 narrow widths instead of pushing Issue card off-window. -->
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel x:Name="ChipDetails" Orientation="Horizontal"
                                            Margin="0,0,16,0">
                                    <TextBlock Text="&#xF058;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChipDetails" Text="Details complete"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="ChipUidNew" Orientation="Horizontal"
                                            Margin="0,0,16,0">
                                    <TextBlock Text="&#xF058;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChipUidNew" Text="Employee ID is new"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="ChipPhoto" Orientation="Horizontal">
                                    <TextBlock Text="&#xF058;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChipPhoto" Text="Photo ready"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtStatus" Margin="16,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{StaticResource TextBrush}" FontSize="12"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOutputText" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center">
                                    <Run x:Name="RunSaves" Text="Saves image · "/><Hyperlink Click="GoSettings_Click"><Run Text="change in Settings"/></Hyperlink>
                                </TextBlock>
                                <Button x:Name="BtnSave" Click="Save_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="20,0,0,0"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF02F;" FontFamily="{StaticResource IconFont}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Issue card" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+Enter" FontSize="11" FontWeight="Normal"
                                                   Opacity="0.8" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== BATCH ===== -->
                <Grid x:Name="PageBatch" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== BATCH HEADER (§2.1) ===== -->
                    <Grid Grid.Row="0" Margin="24,20,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtBatchName" Text="Batch" FontSize="20"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="BtnRenameBatch" Style="{StaticResource IconTextButton}"
                                        Content="&#xF304;" FontFamily="{StaticResource IconFont}"
                                        ToolTip="Rename batch" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Click="BtnRenameBatch_Click"/>
                                <Border x:Name="PnlEmployeeCount" Margin="10,0,0,0" Padding="8,2"
                                        CornerRadius="10" Background="{StaticResource SecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtEmployeeCount" Text="0 employees" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Add or paste employees, prepare their photos, then review each card before issuing."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <!-- compat: old tests read the counts line; UI moved to the progress card -->
                            <TextBlock x:Name="TxtBatchCounts" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xF0C7;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtSaved" Text="Not saved yet" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="BtnBatches" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" Click="BtnBatches_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Batches "/>
                                    <TextBlock Text="&#xF078;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNewBatch" Style="{StaticResource SecondaryButton}"
                                    Click="BtnNewBatch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF067;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="New batch"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ===== BATCH PROGRESS CARD (§2.2) ===== -->
                    <Border Grid.Row="1" x:Name="PnlBatchProgress" Margin="24,0,24,16" Padding="16"
                            CornerRadius="6" Background="{StaticResource PanelLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="BtnReview" Style="{StaticResource PrimaryButton}"
                                        Click="BatchReview_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF06E;" FontFamily="{StaticResource IconFont}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Review cards"/>
                                        <TextBlock Text="Ctrl+R" FontSize="11" FontWeight="Normal"
                                                   Opacity="0.8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtReviewReason" Text="Opens the first card that needs review"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="TxtIssuedCount" Text="No rows yet" FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtRemaining" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Margin="0,10,0,0" Height="8" CornerRadius="4" ClipToBounds="True"
                                        Background="{StaticResource SecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid x:Name="GridProgress">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColIssued" Width="0*"/>
                                            <ColumnDefinition x:Name="ColReview" Width="0*"/>
                                            <ColumnDefinition x:Name="ColAttention" Width="0*"/>
                                            <ColumnDefinition x:Name="ColProcessing" Width="0*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SuccessBrush}"/>
                                        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="{StaticResource ErrorBrush}"/>
                                        <Border Grid.Column="3" Background="{StaticResource WarningBrush}"/>
                                    </Grid>
                                </Border>
                                <WrapPanel x:Name="PnlBatchLegend" Margin="0,10,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- compat status line (old bottom bar text) -->
                    <TextBlock x:Name="TxtBatchStatus" Grid.Row="5" Visibility="Collapsed"/>

                    <!-- ===== BATCH TOOLBAR (§2.3) ===== -->
                    <Grid x:Name="PnlBatchToolbar" Grid.Row="3" Margin="24,0,24,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="PnlBatchButtons" Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center">
                            <Button x:Name="BtnAddRow" Style="{StaticResource ToolButton}"
                                    Click="BatchAddRow_Click" ToolTip="Add row (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF067;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add row" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ctrl+N" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDupRow" Style="{StaticResource ToolButton}"
                                    Click="BatchDupRow_Click" Margin="6,0,0,0" ToolTip="Duplicate (Ctrl+D)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ctrl+D" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnPasteRows" Style="{StaticResource ToolButton}"
                                    Click="BatchPaste_Click" Margin="6,0,0,0"
                                    ToolTip="Paste tab or comma separated rows from Excel/CSV (Ctrl+V)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Paste from Excel" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ctrl+V" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Height="20" Margin="10,0" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Button x:Name="BtnImportCsv" Style="{StaticResource ToolButton}"
                                    Click="BatchImport_Click" Margin="0,0,6,0">Import CSV…</Button>
                            <Button x:Name="BtnExportCsv" Style="{StaticResource ToolButton}"
                                    Click="BatchExportCsv_Click">Export CSV…</Button>
                            <Border Width="1" Height="20" Margin="10,0" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Button x:Name="BtnPreparePhotos" Style="{StaticResource ToolButton}"
                                    Click="StartBatch_Click"
                                    ToolTip="Runs background removal + auto-positioning. Nothing is approved or issued. (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF0D0;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Prepare photos" VerticalAlignment="Center"/>
                                    <TextBlock Text="F5" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRemoveSelected" Style="{StaticResource ToolButtonDanger}"
                                    Click="BatchRemoveSelected_Click" Margin="6,0,0,0"
                                    ToolTip="Remove selected rows (Del)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtRemoveLabel" Text="Remove selected"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Del" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <!-- search: right side at wide widths, drops to row 1 when narrow -->
                        <Grid x:Name="PnlBatchSearch" Grid.Row="0" Grid.Column="1"
                              Width="256" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBox x:Name="TxtBatchSearch" Height="32" FontSize="12"
                                     BorderBrush="{StaticResource InputBrush}" BorderThickness="1"
                                     Background="{StaticResource BackgroundBrush}" Padding="30,0,8,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtBatchSearch_TextChanged"
                                     KeyDown="TxtBatchSearch_KeyDown"/>
                            <StackPanel x:Name="TxtSearchHint" Orientation="Horizontal" Margin="10,0,0,0"
                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xF002;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Find name or Employee ID  (Ctrl+F)" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== BATCH FILTER CHIPS (§2.4) ===== -->
                    <WrapPanel x:Name="PnlBatchChips" Grid.Row="2" Margin="24,0,24,8">
                        <RadioButton x:Name="ChkFilterAll" Tag="all" GroupName="BatchFilters" IsChecked="True"
                                     Style="{StaticResource FilterChip}" Checked="BatchFilter_Changed"/>
                        <RadioButton x:Name="ChkFilterAttention" Tag="attention" GroupName="BatchFilters"
                                     Style="{StaticResource FilterChipAttention}"
                                     Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                        <RadioButton x:Name="ChkFilterReview" Tag="review" GroupName="BatchFilters"
                                     Style="{StaticResource FilterChip}"
                                     Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                        <RadioButton x:Name="ChkFilterIssued" Tag="issued" GroupName="BatchFilters"
                                     Style="{StaticResource FilterChip}"
                                     Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                        <RadioButton x:Name="ChkFilterReissue" Tag="reissue" GroupName="BatchFilters"
                                     Style="{StaticResource FilterChipReissue}"
                                     Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <!-- ===== BATCH GRID (§2.5-2.8) ===== -->
                    <Border Grid.Row="4" Margin="24,0,24,12" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
                    <DataGrid x:Name="DgBatch" AutoGenerateColumns="False"
                              RowHeight="44" MinHeight="200" MinWidth="1080"
                              CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                              CellStyle="{StaticResource BatchCell}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              ColumnHeaderStyle="{StaticResource BatchHeader}"
                              RowStyle="{StaticResource BatchRow}"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              CellEditEnding="DgBatch_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Employee" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="28" Height="32" Margin="0,0,10,0">
                                                <!-- thumbnail (photo/cutout present) -->
                                                <Border CornerRadius="4" ClipToBounds="True"
                                                        Opacity="{Binding ThumbOpacity}"
                                                        Visibility="{Binding ShowThumb, Converter={StaticResource BoolToVis}}"
                                                        Background="{StaticResource PanelLightBrush}">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border>
                                                <!-- red dashed "needs photo" placeholder: click opens Browse only -->
                                                <Grid Cursor="Hand" ToolTip="Click to add a photo"
                                                      MouseLeftButtonUp="BatchPlaceholder_Click"
                                                      Visibility="{Binding ShowPhotoPlaceholderRed, Converter={StaticResource BoolToVis}}">
                                                    <Rectangle Stroke="{StaticResource ErrorBrush}" StrokeThickness="1"
                                                               StrokeDashArray="3 2" Fill="#0DEF4444" RadiusX="4" RadiusY="4"/>
                                                    <TextBlock Text="&#xF007;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{StaticResource ErrorBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- grey draft placeholder -->
                                                <Grid Cursor="Hand" ToolTip="Click to add a photo"
                                                      MouseLeftButtonUp="BatchPlaceholder_Click"
                                                      Visibility="{Binding ShowPhotoPlaceholderGrey, Converter={StaticResource BoolToVis}}">
                                                    <Rectangle Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                                               Fill="{StaticResource SecondaryBrush}" RadiusX="4" RadiusY="4"/>
                                                    <TextBlock Text="&#xF007;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox x:Name="NameInput"
                                                         Style="{StaticResource GridInput}"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" FontWeight="SemiBold"
                                                         VerticalContentAlignment="Center"
                                                         CaretBrush="{StaticResource TextBrush}"
                                                         KeyDown="BatchText_KeyDown"/>
                                                <TextBlock Text="Full name" FontStyle="Italic"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding NameEmpty, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Employee ID" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox x:Name="UidInput"
                                                     Style="{StaticResource GridInput}"
                                                     Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" FontSize="12"
                                                     BorderBrush="{Binding UidInvalidBrush}"
                                                     VerticalContentAlignment="Center"
                                                     CaretBrush="{StaticResource TextBrush}"
                                                     KeyDown="BatchText_KeyDown"
                                                     LostFocus="BatchUid_LostFocus"/>
                                            <TextBlock Text="Employee ID" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding UidEmpty, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding UidCounterText}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="0,0,7,1"
                                                       Visibility="{Binding IsKeyboardFocused, ElementName=UidInput, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Blood group" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.BloodGroups}}"
                                                  SelectedItem="{Binding Blood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"
                                                  DropDownClosed="BatchCellCombo_Closed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Position" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding Source={x:Static core:Config.Positions}}"
                                                      SelectedItem="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0" Background="Transparent"
                                                      DropDownClosed="BatchCellCombo_Closed"/>
                                            <TextBlock Text="Choose position" Foreground="{StaticResource MutedBrush}"
                                                       FontStyle="Italic" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Margin="6,0,28,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding PositionEmpty, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Contract" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.ContractTypes}}"
                                                  SelectedItem="{Binding Contract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"
                                                  DropDownClosed="BatchCellCombo_Closed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Print date" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource GridInput}"
                                                 Text="{Binding PrintDateDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="{StaticResource TextBrush}"
                                                 KeyDown="BatchText_KeyDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Card type" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2"
                                                Background="{Binding CardTypePillBg}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CardTypePillIcon}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="9" Foreground="{Binding CardTypePillFg}"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding CardType}" FontSize="11"
                                                           Foreground="{Binding CardTypePillFg}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" BorderThickness="1"
                                                Background="{Binding StatusPillBg}"
                                                BorderBrush="{Binding StatusPillBorder}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusPillIcon}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="9" Foreground="{Binding StatusPillFg}"
                                                           Tag="BatchSpinner"
                                                           VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform CenterX="4.5" CenterY="4.5"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusPillLabel}" FontSize="11"
                                                           Foreground="{Binding StatusPillFg}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Message" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding MessageBrush}"
                                                       ToolTip="{Binding Message}"/>
                                            <TextBlock Text="Add photo…" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Cursor="Hand"
                                                       TextDecorations="Underline"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       MouseLeftButtonUp="BatchAddPhotoLink_Click"
                                                       Visibility="{Binding ShowAddPhotoLink, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="8,6,8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBatchShowing" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                        <Button Content="Cancel" Click="BatchCancel_Click" Margin="14,0,0,0" IsEnabled="False" x:Name="BtnBatchCancel"/>
                        <Button Content="Open output" Click="BatchOpenOutput_Click" Margin="8,0,0,0"/>
                        <ProgressBar x:Name="BatchProgress" Width="200" Height="14" Margin="16,0,0,0"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBatchLog" Grid.Row="6" Margin="8,0,8,6" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" FontSize="11"/>
                </Grid>

                <!-- ===== RECORDS ===== -->
                <Grid x:Name="PageRecords" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="Records" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Issued cards, reprints, exports, and data tools" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="8,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtSearch" Width="240" ToolTip="Search UID or name (Ctrl+F)"
                                     KeyDown="Search_KeyDown"/>
                            <ComboBox x:Name="CmbContractFilter" Width="120" Margin="8,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Contract type">
                                <ComboBoxItem Content="Any contract"/>
                                <ComboBoxItem Content="Permanent"/>
                                <ComboBoxItem Content="Contractual"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbValidityFilter" Width="130" Margin="6,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Validity">
                                <ComboBoxItem Content="Any validity"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Expires soon"/>
                                <ComboBoxItem Content="Expired"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbIssuedFilter" Width="130" Margin="6,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Issued date">
                                <ComboBoxItem Content="Any time"/>
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="Last 7 days"/>
                                <ComboBoxItem Content="Last 30 days"/>
                            </ComboBox>
                            <Button Content="Refresh" Click="RefreshRecords_Click" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TxtRecordCount" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="PnlUndo" Visibility="Collapsed" Margin="0,6,0,0" Padding="8,5"
                                CornerRadius="6" Background="{StaticResource PrimaryTintBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock x:Name="TxtUndo" Text="Record deleted" VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Content="Undo" DockPanel.Dock="Right" Padding="12,2"
                                        Click="UndoDelete_Click"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="LstRecords" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  CellStyle="{StaticResource BatchCell}"
                                  SelectionChanged="Record_Selected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee" Binding="{Binding Name}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Employee ID" Binding="{Binding Uid}" Width="100"/>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Contract" Binding="{Binding ContractType}" Width="90"/>
                                <DataGridTextColumn Header="Last issued" Binding="{Binding LastIssued}" Width="115"/>
                                <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntil}" Width="95"/>
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="7,1" HorizontalAlignment="Center"
                                                    Background="{Binding BadgeBrush}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10"
                                                           Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Padding="10"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Height="150" CornerRadius="6" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="ImgRecPreview" Stretch="Uniform" Margin="4"/>
                                        <TextBlock x:Name="TxtRecPreviewEmpty" Text="No card image"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="PnlEditBanner" Grid.Row="1" CornerRadius="6" Margin="0,8,0,0"
                                        Padding="10,7" Visibility="Collapsed"
                                        Background="{StaticResource PrimaryTintBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtEditBanner" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="Re-issue" Click="ReissueBanner_Click"
                                                Margin="10,0,0,0" Padding="12,3"/>
                                    </StackPanel>
                                </Border>
                                <TabControl Grid.Row="2" Margin="0,8,0,0">
                                    <TabItem Header="Details">
                                        <StackPanel x:Name="DtlDetails" Margin="4"/>
                                    </TabItem>
                                    <TabItem Header="Files">
                                        <StackPanel x:Name="DtlFiles" Margin="4"/>
                                    </TabItem>
                                    <TabItem Header="History">
                                        <ListBox x:Name="LstHistory" Margin="4"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="PnlRecActions" Grid.Row="3" Orientation="Horizontal"
                                Margin="8,4,8,0" VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}">
                        <Button Content="Reprint" Click="Reprint_Click" IsEnabled="False" x:Name="BtnReprint"/>
                        <Button Content="Re-issue" Click="Reissue_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnReissue"/>
                        <Button Content="Edit" Click="EditRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnEditRec"/>
                        <Button Content="Save card as" Click="ExportRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnExportRec"/>
                        <Button Content="Show card file" Click="ShowCardFile_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnShowFile"/>
                        <Button Content="Delete" Click="DeleteRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnDeleteRec"/>
                        <TextBlock x:Name="TxtRecordInfo" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PnlRecTools" Grid.Row="4" Orientation="Horizontal"
                                Margin="8,0,8,8" Background="{StaticResource PanelBrush}">
                        <Button Content="Export CSV" Click="ExportCsv_Click"/>
                        <Button Content="Export JSON" Click="ExportJson_Click" Margin="6,0,0,0"/>
                        <Button Content="Back up now" Click="BackupDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Restore..." Click="RestoreDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Deleted records..." Click="DeletedRecords_Click" Margin="6,0,0,0"/>
                        <Button Content="Clear all..." Style="{StaticResource DestructiveOutlineButton}" Click="ClearAll_Click" Margin="16,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== SETTINGS ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,20" MaxWidth="720">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Issuing, saved files, and new-card defaults — changes save instantly"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>

                        <GroupBox Header="Issuing" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="SetConfirm" Content="Ask me to confirm before issuing a card"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <CheckBox IsChecked="True" IsEnabled="False" Margin="0,6,0,0"
                                          Foreground="{StaticResource MutedBrush}"
                                          Content="Always confirm re-issues"/>
                                <TextBlock Text="Re-issues always ask for confirmation — this protects against issuing the wrong card twice."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Saved files" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox IsChecked="True" IsEnabled="False" Content="Card image (PNG) — always saved, 300 DPI"/>
                                <CheckBox x:Name="SetPdf" Content="Also save a PDF" Margin="0,6,0,0"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <TextBlock Text="Save cards to" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="TxtSaveFolder" IsReadOnly="True" Width="380"/>
                                    <Button Content="Browse..." Margin="6,0,0,0" Click="BrowseSaveFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="Dates are shown as dd/MM/yyyy" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="New card defaults" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <TextBlock Text="Contract type" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SetContract" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="Print date default" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetPrintDate" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Today"/>
                                </ComboBox>
                                <TextBlock Text="Photo background" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetBg" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Plain white" Tag="PlainWhite"/>
                                    <ComboBoxItem Content="Model (complex background)" Tag="Model"/>
                                    <ComboBoxItem Content="Keep as is" Tag="Keep"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Backup and restore" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="SetIncludeCards" Content="Include card images"
                                          IsChecked="True" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Back up to file…" Click="BackupToFile_Click"/>
                                    <Button Content="Restore from file…" Click="RestoreFromFile_Click" Margin="8,0,0,0"/>
                                    <Button Content="Open backup folder" Click="OpenBackupFolder_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text=".idbackup files contain the database, photos, and card images. Settings are not included."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Phase 7: success banner — "Card issued for {Name}." 6 s,
                 stays visible while hovered. -->
            <Border x:Name="PnlSuccessBanner" Grid.ColumnSpan="2" Panel.ZIndex="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                    CornerRadius="6" Padding="14,8" Visibility="Collapsed"
                    Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="1" MouseEnter="SuccessBanner_MouseEnter"
                    MouseLeave="SuccessBanner_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSuccessBanner" Margin="8,0,0,0" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ STATUS BAR (§4.4) ============ -->
        <Border Grid.Row="1" Height="28" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <!-- FIX 4: About link removed — version text is right-aligned,
                     no longer a button. -->
                <TextBlock x:Name="TxtStatusVersion" DockPanel.Dock="Right"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <StackPanel x:Name="PnlStatusLeft" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Offline — all data stays on this PC" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="  |  " Foreground="{StaticResource BorderBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusCount" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="  |  " Foreground="{StaticResource BorderBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusBackup" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <StackPanel x:Name="PnlStatusMsg" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="  |  " Foreground="{StaticResource BorderBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtStatusMsg" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <Button x:Name="BtnStatusMsgFolder" Style="{StaticResource GhostButton}"
                                Content="Open folder" FontSize="11" Height="20" Padding="8,0"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="StatusMsgFolder_Click"/>
                        <Button x:Name="BtnStatusMsgClose" Style="{StaticResource GhostButton}"
                                Content="&#x2715;" FontSize="11" Height="20" Width="22" Padding="0"
                                Margin="4,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="StatusMsgClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
