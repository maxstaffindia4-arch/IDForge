<Window x:Class="IDForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IDForge.Core;assembly=IDForge.Core"
        Title="IDForge" Width="1100" Height="760" FontFamily="{StaticResource AppFontFamily}"
        Icon="pack://application:,,,/IDForge;component/app.ico"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
    <TabControl>
        <!-- ============ NEW CARD ============ -->
        <TabItem Header="New Card">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: form -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Full name" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtName" TextChanged="Field_Changed" MaxLength="40"/>

                        <TextBlock Text="Blood group" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ComboBox x:Name="CmbBlood" SelectionChanged="Field_Changed"/>

                        <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ComboBox x:Name="CmbPosition" SelectionChanged="Field_Changed"/>

                        <TextBlock Text="UID (digits only, e.g. 20250318)" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBox x:Name="TxtUid" TextChanged="Field_Changed" LostFocus="Uid_LostFocus"/>
                        <TextBlock x:Name="ErrUid" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="Contract type" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ComboBox x:Name="CmbContract" SelectionChanged="Field_Changed"/>

                        <TextBlock Text="Print date" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <DatePicker x:Name="DpPrintDate" SelectedDateChanged="Field_Changed"/>

                        <TextBlock Text="Photo" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtPhoto" IsReadOnly="True" Width="200"/>
                            <Button Content="Browse..." Margin="6,0,0,0" Click="BrowsePhoto_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Background:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbBgMode" Width="210" Margin="8,0,0,0"
                                      SelectionChanged="BgMode_Changed">
                                <ComboBoxItem Content="Plain white background" IsSelected="True"/>
                                <ComboBoxItem Content="Model (complex background)"/>
                                <ComboBoxItem Content="Keep as is"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="TxtPhotoStatus" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <!-- Photo nudge controls (enabled after photo processed) -->
                        <GroupBox Header="Photo position" Margin="0,10,0,0" IsEnabled="False" x:Name="GrpNudge">
                            <StackPanel Margin="6">
                                <TextBlock Text="Zoom (× auto)"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SldZoom" Width="170" Minimum="0.4" Maximum="3.0" Value="1"
                                            TickFrequency="0.05" ValueChanged="Nudge_Changed"/>
                                    <TextBox x:Name="TxtZoom" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                             Text="1" TextChanged="NudgeText_Changed" Tag="zoom"/>
                                </StackPanel>
                                <TextBlock Text="Horizontal (px)"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SldX" Width="170" Minimum="-320" Maximum="320" Value="0"
                                            TickFrequency="5" ValueChanged="Nudge_Changed"/>
                                    <TextBox x:Name="TxtX" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                             Text="0" TextChanged="NudgeText_Changed" Tag="x"/>
                                </StackPanel>
                                <TextBlock Text="Vertical (px)"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SldY" Width="170" Minimum="-400" Maximum="400" Value="0"
                                            TickFrequency="5" ValueChanged="Nudge_Changed"/>
                                    <TextBox x:Name="TxtY" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                             Text="0" TextChanged="NudgeText_Changed" Tag="y"/>
                                </StackPanel>
                                <Button Content="Reset to auto" Click="ResetNudge_Click" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnApprove" Content="Approve photo" Click="ApprovePhoto_Click" IsEnabled="False"/>
                            <Button x:Name="BtnSave" Content="Save &amp; Issue" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0" IsEnabled="False"/>
                            <CheckBox x:Name="ChkConfirmIssue" Content="Confirm before issue"
                                      Checked="ConfirmIssue_Changed" Unchecked="ConfirmIssue_Changed"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      ToolTip="Ask for confirmation before issuing (re-issue always asks)."/>
                            <CheckBox x:Name="ChkIncludePdf" Content="Also create PDF"
                                      Checked="IncludePdf_Changed" Unchecked="IncludePdf_Changed"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      ToolTip="Write a PDF next to the PNG when issuing."/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: preview -->
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgPreview" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtPreviewHint" Text="Preview appears here"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ RECORDS ============ -->
        <TabItem Header="Records">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8">
                    <TextBox x:Name="TxtSearch" Width="280" ToolTip="Search UID or name"
                             KeyDown="Search_KeyDown"/>
                    <Button Content="Search" Click="Search_Click" Margin="8,0,0,0"/>
                    <Button Content="Refresh" Click="RefreshRecords_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <ListView x:Name="LstRecords" Grid.Row="1" Margin="8"
                          SelectionChanged="Record_Selected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="UID" Width="140" DisplayMemberBinding="{Binding Uid}"/>
                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Position" Width="160" DisplayMemberBinding="{Binding Position}"/>
                            <GridViewColumn Header="Contract" Width="100" DisplayMemberBinding="{Binding ContractType}"/>
                            <GridViewColumn Header="Valid Until" Width="110" DisplayMemberBinding="{Binding ValidUntil}"/>
                            <GridViewColumn Header="Last Issued" Width="150" DisplayMemberBinding="{Binding LastIssued}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                        <Button Content="Reprint" Click="Reprint_Click" IsEnabled="False" x:Name="BtnReprint"/>
                        <Button Content="Re-issue" Click="Reissue_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnReissue"/>
                        <Button Content="Export PNG/PDF" Click="ExportRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnExportRec"/>
                        <Button Content="Edit" Click="EditRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnEditRec"/>
                        <Button Content="Delete" Click="DeleteRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnDeleteRec"/>
                        <TextBlock x:Name="TxtRecordInfo" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                        <Button Content="Export CSV" Click="ExportCsv_Click"/>
                        <Button Content="Export JSON" Click="ExportJson_Click" Margin="6,0,0,0"/>
                        <Button Content="Backup DB" Click="BackupDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Restore..." Click="RestoreDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Deleted..." Click="DeletedRecords_Click" Margin="6,0,0,0"/>
                        <Button Content="Clear All..." Style="{StaticResource DestructiveOutlineButton}" Click="ClearAll_Click" Margin="16,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ============ BATCH ============ -->
        <TabItem Header="Batch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                        One employee per row. Paste from Excel/CSV, or use Import/Export CSV.
                        Columns: UID, Full name, Blood group, Position, Contract type, Print date, Photo path.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add Row" Click="BatchAddRow_Click"/>
                        <Button Content="Duplicate" Click="BatchDupRow_Click" Margin="6,0,0,0"/>
                        <Button Content="Delete Row" Click="BatchDelRow_Click" Margin="6,0,0,0"/>
                        <Button Content="Paste Rows" Click="BatchPaste_Click" Margin="6,0,0,0"
                                ToolTip="Paste tab or comma separated rows from Excel/CSV"/>
                        <Button Content="Import CSV..." Click="BatchImport_Click" Margin="6,0,0,0"/>
                        <Button Content="Export CSV..." Click="BatchExportCsv_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <DataGrid x:Name="DgBatch" Grid.Row="1" Margin="8" AutoGenerateColumns="False"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" MouseDoubleClick="DgBatch_MouseDoubleClick"
                          CellEditEnding="DgBatch_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="120"/>
                        <DataGridTextColumn Header="Full name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn Header="Blood" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={x:Static core:Config.BloodGroups}}"
                                              SelectedItem="{Binding Blood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Position" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={x:Static core:Config.Positions}}"
                                              SelectedItem="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Contract" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={x:Static core:Config.ContractTypes}}"
                                              SelectedItem="{Binding Contract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Print date" Binding="{Binding PrintDateText}" Width="100"/>
                        <DataGridTextColumn Header="Photo path" Binding="{Binding PhotoPath}" Width="180"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Browse" Click="BatchBrowse_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="220" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,4">
                    <Button Content="Process photos" Click="StartBatch_Click" x:Name="BtnStartBatch"
                            ToolTip="Runs background removal + auto-positioning. Nothing is approved or issued."/>
                    <Button Content="Review" Click="BatchReview_Click" Margin="8,0,0,0" FontWeight="SemiBold"
                            ToolTip="Open the review screen — approve &amp; issue each card manually."/>
                    <Button Content="Cancel" Click="BatchCancel_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnBatchCancel"/>
                    <Button Content="Open output" Click="BatchOpenOutput_Click" Margin="8,0,0,0"/>
                    <ProgressBar x:Name="BatchProgress" Width="200" Height="14" Margin="16,0,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtBatchStatus" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtBatchLog" Grid.Row="3" Margin="8,0,8,6" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" FontSize="11"/>
            </Grid>
        </TabItem>
    </TabControl>
    <Button x:Name="BtnAbout" Content="?" Width="30" Height="26"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0"
            FontWeight="Bold" Click="About_Click" ToolTip="About IDForge"/>
    </Grid>
</Window>
