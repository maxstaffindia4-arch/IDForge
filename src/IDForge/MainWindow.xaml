<Window x:Class="IDForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IDForge.Core;assembly=IDForge.Core"
        Title="IDForge — New card" Width="1100" Height="760" FontFamily="{StaticResource AppFontFamily}"
        Icon="pack://application:,,,/IDForge;component/app.ico"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Left-nav item: blue accent bar + light blue background when checked -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,7"
                                Background="Transparent" BorderThickness="0">
                            <Grid>
                                <Rectangle x:Name="accent" Width="3" Height="18" RadiusX="1.5"
                                           HorizontalAlignment="Left" Fill="Transparent"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="accent" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ MENU BAR ============ -->
        <Menu Grid.Row="0" Background="{StaticResource PanelLightBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="(no actions yet)" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle navigation" Click="MenuToggleNav_Click"/>
            </MenuItem>
            <MenuItem Header="_Records">
                <MenuItem Header="_Go to Records  Ctrl+3" Click="NavRecords_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Back up now  Ctrl+B" Click="NavBackup_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About  F1" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="208" MinWidth="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT NAV ============ -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="8" Padding="10" CornerRadius="6"
                            Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Backed up" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="TxtLastBackup" Text="Never" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"/>
                            <Button Content="Back up now" Style="{StaticResource CompactButton}"
                                    Click="NavBackup_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="8">
                        <TextBlock x:Name="LblIssueCards" Text="ISSUE CARDS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="4,0,0,4"/>
                        <RadioButton x:Name="NavNewCard" Style="{StaticResource NavItem}" GroupName="nav"
                                     IsChecked="True" Click="NavNewCard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="N" FontWeight="Bold" Width="18"/>
                                <TextBlock x:Name="NavLblNewCard" Text="New card"/>
                                <TextBlock x:Name="NavKeyNewCard" Text="Ctrl+1" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBatch" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavBatch_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B" FontWeight="Bold" Width="18"/>
                                <TextBlock x:Name="NavLblBatch" Text="Batch"/>
                                <Border x:Name="NavBatchBadge" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                        Background="{StaticResource PrimaryBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtNavBatchCount" Text="0" FontSize="10"
                                               Foreground="{StaticResource WhiteBrush}"/>
                                </Border>
                                <TextBlock x:Name="NavKeyBatch" Text="Ctrl+2" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock x:Name="LblManage" Text="MANAGE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="4,14,0,4"/>
                        <RadioButton x:Name="NavRecords" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavRecords_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="R" FontWeight="Bold" Width="18"/>
                                <TextBlock x:Name="NavLblRecords" Text="Records"/>
                                <TextBlock x:Name="NavKeyRecords" Text="Ctrl+3" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="S" FontWeight="Bold" Width="18"/>
                                <TextBlock x:Name="NavLblSettings" Text="Settings"/>
                                <TextBlock x:Name="NavKeySettings" Text="Ctrl+," FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ PAGES ============ -->
            <Grid Grid.Column="1">

                <!-- ===== NEW CARD ===== -->
                <Grid x:Name="PageNewCard">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="New card" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Issue a single staff ID card" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Button Content="Issue options — change in Settings" Style="{StaticResource GhostButton}"
                                DockPanel.Dock="Right" VerticalAlignment="Center" Click="GoSettings_Click"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: form -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,0,12,12">
                                <TextBlock Text="Full name" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtName" TextChanged="Field_Changed" MaxLength="40"/>

                                <TextBlock Text="Blood group" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox x:Name="CmbBlood" SelectionChanged="Field_Changed"/>

                                <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox x:Name="CmbPosition" SelectionChanged="Field_Changed"/>

                                <TextBlock Text="UID (digits only, e.g. 20250318)" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBox x:Name="TxtUid" TextChanged="Field_Changed" LostFocus="Uid_LostFocus"/>
                                <TextBlock x:Name="ErrUid" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

                                <TextBlock Text="Contract type" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox x:Name="CmbContract" SelectionChanged="Field_Changed"/>

                                <TextBlock Text="Print date" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <DatePicker x:Name="DpPrintDate" SelectedDateChanged="Field_Changed"/>

                                <TextBlock Text="Photo" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtPhoto" IsReadOnly="True" Width="200"/>
                                    <Button Content="Browse..." Margin="6,0,0,0" Click="BrowsePhoto_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Background:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbBgMode" Width="210" Margin="8,0,0,0"
                                              SelectionChanged="BgMode_Changed">
                                        <ComboBoxItem Content="Plain white background" IsSelected="True"/>
                                        <ComboBoxItem Content="Model (complex background)"/>
                                        <ComboBoxItem Content="Keep as is"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="TxtPhotoStatus" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <!-- Photo nudge controls (enabled after photo processed) -->
                                <GroupBox Header="Photo position" Margin="0,10,0,0" IsEnabled="False" x:Name="GrpNudge">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Zoom (× auto)"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="SldZoom" Width="170" Minimum="0.4" Maximum="3.0" Value="1"
                                                    TickFrequency="0.05" ValueChanged="Nudge_Changed"/>
                                            <TextBox x:Name="TxtZoom" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                                     Text="1" TextChanged="NudgeText_Changed" Tag="zoom"/>
                                        </StackPanel>
                                        <TextBlock Text="Horizontal (px)"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="SldX" Width="170" Minimum="-320" Maximum="320" Value="0"
                                                    TickFrequency="5" ValueChanged="Nudge_Changed"/>
                                            <TextBox x:Name="TxtX" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                                     Text="0" TextChanged="NudgeText_Changed" Tag="x"/>
                                        </StackPanel>
                                        <TextBlock Text="Vertical (px)"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="SldY" Width="170" Minimum="-400" Maximum="400" Value="0"
                                                    TickFrequency="5" ValueChanged="Nudge_Changed"/>
                                            <TextBox x:Name="TxtY" Width="55" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                                     Text="0" TextChanged="NudgeText_Changed" Tag="y"/>
                                        </StackPanel>
                                        <Button Content="Reset to auto" Click="ResetNudge_Click" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnApprove" Content="Approve photo" Click="ApprovePhoto_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnSave" Content="Save &amp; Issue" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: preview -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8">
                            <Grid ClipToBounds="True">
                                <Image x:Name="ImgPreview" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="TxtPreviewHint" Text="Preview appears here"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== BATCH ===== -->
                <Grid x:Name="PageBatch" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="Batch" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Prepare and issue many cards at once" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="8">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                            One employee per row. Paste from Excel/CSV, or use Import/Export CSV.
                            Columns: UID, Full name, Blood group, Position, Contract type, Print date, Photo path.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add Row" Click="BatchAddRow_Click"/>
                            <Button Content="Duplicate" Click="BatchDupRow_Click" Margin="6,0,0,0"/>
                            <Button Content="Delete Row" Click="BatchDelRow_Click" Margin="6,0,0,0"/>
                            <Button Content="Paste Rows" Click="BatchPaste_Click" Margin="6,0,0,0"
                                    ToolTip="Paste tab or comma separated rows from Excel/CSV"/>
                            <Button Content="Import CSV..." Click="BatchImport_Click" Margin="6,0,0,0"/>
                            <Button Content="Export CSV..." Click="BatchExportCsv_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="DgBatch" Grid.Row="2" Margin="8" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" MouseDoubleClick="DgBatch_MouseDoubleClick"
                              CellEditEnding="DgBatch_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="120"/>
                            <DataGridTextColumn Header="Full name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="Blood" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.BloodGroups}}"
                                                  SelectedItem="{Binding Blood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Position" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.Positions}}"
                                                  SelectedItem="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Contract" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.ContractTypes}}"
                                                  SelectedItem="{Binding Contract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Print date" Binding="{Binding PrintDateText}" Width="100"/>
                            <DataGridTextColumn Header="Photo path" Binding="{Binding PhotoPath}" Width="180"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Browse" Click="BatchBrowse_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="220" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,8,4">
                        <Button Content="Process photos" Click="StartBatch_Click" x:Name="BtnStartBatch"
                                ToolTip="Runs background removal + auto-positioning. Nothing is approved or issued."/>
                        <Button Content="Review" Click="BatchReview_Click" Margin="8,0,0,0" FontWeight="SemiBold"
                                ToolTip="Open the review screen — approve &amp; issue each card manually."/>
                        <Button Content="Cancel" Click="BatchCancel_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnBatchCancel"/>
                        <Button Content="Open output" Click="BatchOpenOutput_Click" Margin="8,0,0,0"/>
                        <ProgressBar x:Name="BatchProgress" Width="200" Height="14" Margin="16,0,0,0"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtBatchStatus" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBatchLog" Grid.Row="4" Margin="8,0,8,6" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" FontSize="11"/>
                </Grid>

                <!-- ===== RECORDS ===== -->
                <Grid x:Name="PageRecords" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="Records" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Issued cards, reprints, exports, and data tools" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8">
                        <TextBox x:Name="TxtSearch" Width="280" ToolTip="Search UID or name"
                                 KeyDown="Search_KeyDown"/>
                        <Button Content="Search" Click="Search_Click" Margin="8,0,0,0"/>
                        <Button Content="Refresh" Click="RefreshRecords_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="LstRecords" Grid.Row="2" Margin="8"
                              SelectionChanged="Record_Selected">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="UID" Width="140" DisplayMemberBinding="{Binding Uid}"/>
                                <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Position" Width="160" DisplayMemberBinding="{Binding Position}"/>
                                <GridViewColumn Header="Contract" Width="100" DisplayMemberBinding="{Binding ContractType}"/>
                                <GridViewColumn Header="Valid Until" Width="110" DisplayMemberBinding="{Binding ValidUntil}"/>
                                <GridViewColumn Header="Last Issued" Width="150" DisplayMemberBinding="{Binding LastIssued}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                            <Button Content="Reprint" Click="Reprint_Click" IsEnabled="False" x:Name="BtnReprint"/>
                            <Button Content="Re-issue" Click="Reissue_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnReissue"/>
                            <Button Content="Export PNG/PDF" Click="ExportRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnExportRec"/>
                            <Button Content="Edit" Click="EditRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnEditRec"/>
                            <Button Content="Delete" Click="DeleteRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnDeleteRec"/>
                            <TextBlock x:Name="TxtRecordInfo" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                            <Button Content="Export CSV" Click="ExportCsv_Click"/>
                            <Button Content="Export JSON" Click="ExportJson_Click" Margin="6,0,0,0"/>
                            <Button Content="Backup DB" Click="BackupDb_Click" Margin="6,0,0,0"/>
                            <Button Content="Restore..." Click="RestoreDb_Click" Margin="6,0,0,0"/>
                            <Button Content="Deleted..." Click="DeletedRecords_Click" Margin="6,0,0,0"/>
                            <Button Content="Clear All..." Style="{StaticResource DestructiveOutlineButton}" Click="ClearAll_Click" Margin="16,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== SETTINGS ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,20" MaxWidth="720">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Issuing, saved files, and new-card defaults — changes save instantly"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>

                        <GroupBox Header="Issuing" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="SetConfirm" Content="Ask me to confirm before issuing a card"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <CheckBox IsChecked="True" IsEnabled="False" Margin="0,6,0,0"
                                          Content="Always confirm re-issues"/>
                                <TextBlock Text="Re-issues always ask for confirmation — this protects against issuing the wrong card twice."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Saved files" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox IsChecked="True" IsEnabled="False" Content="Card image (PNG) — always saved, 300 DPI"/>
                                <CheckBox x:Name="SetPdf" Content="Also save a PDF" Margin="0,6,0,0"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <TextBlock Text="Save cards to" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="TxtSaveFolder" IsReadOnly="True" Width="380"/>
                                    <Button Content="Browse..." Margin="6,0,0,0" Click="BrowseSaveFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="Dates are shown as dd/MM/yyyy" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="New card defaults" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <TextBlock Text="Contract type" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SetContract" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="Print date default" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetPrintDate" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Today" IsSelected="True"/>
                                </ComboBox>
                                <TextBlock Text="Photo background" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetBg" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Plain white" Tag="PlainWhite" IsSelected="True"/>
                                    <ComboBoxItem Content="Model (complex background)" Tag="Model"/>
                                    <ComboBoxItem Content="Keep as is" Tag="Keep"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelLightBrush}">
            <DockPanel Margin="10,4">
                <StackPanel x:Name="PnlStatusLeft" Orientation="Horizontal" DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  Offline — all data stays on this PC" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusCount" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusBackup" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <StackPanel x:Name="PnlStatusMsg" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtStatusMsg" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtStatusVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="IDForge · About (F1)"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
