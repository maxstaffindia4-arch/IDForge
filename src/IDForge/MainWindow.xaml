<Window x:Class="IDForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IDForge.Core;assembly=IDForge.Core"
        xmlns:controls="clr-namespace:IDForge.Controls"
        Language="en-GB"
        Title="IDForge — New card" Width="1100" Height="760" FontFamily="{StaticResource AppFontFamily}"
        Icon="pack://application:,,,/IDForge;component/app.ico"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BatchCellFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatchCell" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BatchCellFocus}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <!-- No template focus rectangles: the blue FocusVisualStyle
                             ring is the only focus indicator (also in selected rows). -->
                        <Border Padding="4,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Left-nav item: light blue background when checked; blue ring only on keyboard focus -->
        <!-- Keyboard-only focus ring: WPF shows FocusVisualStyle only after
             keyboard navigation, never after a mouse click. -->
        <!-- Must target Control: WPF's FocusVisualAdorner applies this style to
             an internal Control, so a narrower TargetType crashes on keyboard focus. -->
        <Style x:Key="NavFocusRing" TargetType="Control">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                                CornerRadius="6" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="18,7,10,7"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented contract-type choice (Permanent / Contractual) -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,8"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview zoom selector (Fit / 100% / 200%) -->
        <Style x:Key="ZoomButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatchFilterChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource PanelLightBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ MENU BAR ============ -->
        <Menu Grid.Row="0" Background="{StaticResource PanelLightBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="(no actions yet)" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle navigation" Click="MenuToggleNav_Click"/>
            </MenuItem>
            <MenuItem Header="_Records">
                <MenuItem Header="_Go to Records  Ctrl+3" Click="NavRecords_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Back up now  Ctrl+B" Click="NavBackup_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuHelp" Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Click="HelpShortcuts_Click"/>
                <MenuItem Header="_Quick guide: issuing a card, using Batch, backup and restore"
                          Click="HelpQuickGuide_Click"/>
                <MenuItem Header="_Troubleshooting: missing output folder, dates, backup"
                          Click="HelpTroubleshooting_Click"/>
                <Separator/>
                <MenuItem Header="_About IDForge…" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="208" MinWidth="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT NAV ============ -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border x:Name="PnlBackupFull" DockPanel.Dock="Bottom" Margin="8" Padding="10" CornerRadius="6"
                            Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Backed up" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="TxtLastBackup" Text="Never" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"/>
                            <Button Content="Back up now" Style="{StaticResource CompactButton}"
                                    Click="NavBackup_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PnlBackupCompact" DockPanel.Dock="Bottom" Margin="10,8" Width="44" Height="44"
                            Padding="0" HorizontalAlignment="Center"
                            Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonUp="NavBackup_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="18"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="PnlNavItems" Margin="8">
                        <TextBlock x:Name="LblIssueCards" Text="ISSUE CARDS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="4,0,0,4"/>
                        <Border x:Name="DvdIssueCards" Height="1" Margin="8,2"
                                Background="{StaticResource BorderBrush}" Visibility="Collapsed"/>
                        <RadioButton x:Name="NavNewCard" Style="{StaticResource NavItem}" GroupName="nav"
                                     IsChecked="True" Click="NavNewCard_Click" ToolTip="New card (Ctrl+1)">
                            <StackPanel x:Name="NavPnlNewCard" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="15"
                                           Width="22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblNewCard" Text="New card"/>
                                <TextBlock x:Name="NavKeyNewCard" Text="Ctrl+1" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBatch" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavBatch_Click" ToolTip="Batch (Ctrl+2)">
                            <Grid x:Name="NavPnlBatch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="15"
                                               Width="22" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblBatch" Text="Batch"/>
                                    <TextBlock x:Name="NavKeyBatch" Text="Ctrl+2" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border x:Name="NavBatchBadge" CornerRadius="8" Padding="6,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Background="{StaticResource PrimaryBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtNavBatchCount" Text="0" FontSize="10"
                                               Foreground="{StaticResource WhiteBrush}"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                        <TextBlock x:Name="LblManage" Text="MANAGE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="4,14,0,4"/>
                        <Border x:Name="DvdManage" Height="1" Margin="8,2"
                                Background="{StaticResource BorderBrush}" Visibility="Collapsed"/>
                        <RadioButton x:Name="NavRecords" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavRecords_Click" ToolTip="Records (Ctrl+3)">
                            <StackPanel x:Name="NavPnlRecords" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="15"
                                           Width="22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblRecords" Text="Records"/>
                                <TextBlock x:Name="NavKeyRecords" Text="Ctrl+3" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                     Click="NavSettings_Click" ToolTip="Settings (Ctrl+,)">
                            <StackPanel x:Name="NavPnlSettings" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15"
                                           Width="22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLblSettings" Text="Settings"/>
                                <TextBlock x:Name="NavKeySettings" Text="Ctrl+," FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ PAGES ============ -->
            <Grid Grid.Column="1">

                <!-- ===== NEW CARD ===== -->
                <Grid x:Name="PageNewCard">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page header -->
                    <Grid Grid.Row="0" Margin="14,10,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="New card" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Fill in the employee's details, adjust the photo, then issue the card."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDraftNote" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Clear form" Click="ClearForm_Click"/>
                            <Button Content="Save draft  Ctrl+S" Click="SaveDraft_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Three columns; scrolls horizontally on narrow windows -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="960">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" MinWidth="340"/>
                                <ColumnDefinition Width="*" MinWidth="240"/>
                                <ColumnDefinition Width="360" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== 1 · EMPLOYEE DETAILS ===== -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,0,12,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="1 · Employee details" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ChkDetails" Text="  ✓ complete" FontSize="11"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <TextBlock Margin="0,12,0,2" FontWeight="SemiBold">
                                        <Run Text="Full name"/><Run Text="  *" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <TextBox x:Name="TxtName" TextChanged="Field_Changed" MaxLength="40"/>
                                    <TextBlock x:Name="TxtNameHint" Text="Mixed capitals, check spelling"
                                               FontSize="11" Foreground="{StaticResource WarningBrush}"
                                               Margin="0,2,0,0" Visibility="Collapsed"/>

                                    <TextBlock Margin="0,10,0,2" FontWeight="SemiBold">
                                        <Run Text="Position"/><Run Text="  *" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <ComboBox x:Name="CmbPosition" SelectionChanged="Field_Changed"/>

                                    <TextBlock Margin="0,10,0,2" FontWeight="SemiBold">
                                        <Run Text="Employee ID"/><Run Text="  *" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource WhiteBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource PanelBrush}" Padding="8,0"
                                                    BorderThickness="0,0,1,0"
                                                    BorderBrush="{StaticResource BorderBrush}">
                                                <TextBlock Text="UID" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBox x:Name="TxtUid" Grid.Column="1" BorderThickness="0"
                                                     Background="Transparent" MaxLength="15" Padding="6,4"
                                                     PreviewTextInput="Uid_PreviewTextInput"
                                                     TextChanged="Uid_TextChanged" LostFocus="Uid_LostFocus"
                                                     ToolTip="Numbers only, 4–15 digits. Don't type UID — it's added to the card for you."/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="TxtUidCount" Text="0 / 15" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ErrUid" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="LnkOpenRecord" FontSize="11" Margin="0,2,0,0"
                                               Visibility="Collapsed">
                                        <Hyperlink Click="OpenRecord_Click"
                                                   Foreground="{StaticResource PrimaryBrush}">Open record</Hyperlink>
                                    </TextBlock>

                                    <TextBlock Margin="0,10,0,2" FontWeight="SemiBold">Blood group</TextBlock>
                                    <ComboBox x:Name="CmbBlood" SelectionChanged="Field_Changed"/>

                                    <TextBlock Margin="0,10,0,2" FontWeight="SemiBold">
                                        <Run Text="Print date"/><Run Text="  *" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <DatePicker x:Name="DpPrintDate" SelectedDateChanged="Field_Changed"/>

                                    <TextBlock Margin="0,10,0,2" FontWeight="SemiBold">
                                        <Run Text="Contract type"/><Run Text="  *" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadContractPerm" GroupName="contract"
                                                     Style="{StaticResource SegmentedRadio}" IsChecked="True"
                                                     Checked="Field_Changed">
                                            <StackPanel>
                                                <TextBlock Text="Permanent" FontWeight="SemiBold"/>
                                                <TextBlock Text="Valid 12 months" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadContractContract" GroupName="contract"
                                                     Style="{StaticResource SegmentedRadio}"
                                                     Checked="Field_Changed">
                                            <StackPanel>
                                                <TextBlock Text="Contractual" FontWeight="SemiBold"/>
                                                <TextBlock Text="Valid 6 months" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtValidity" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ===== LIVE PREVIEW ===== -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12,0,12,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Live preview" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Updates as you type" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="RadZoomFit" Content="Fit" GroupName="pzoom"
                                                     Style="{StaticResource ZoomButton}" IsChecked="True"
                                                     Checked="ZoomMode_Changed"/>
                                        <RadioButton x:Name="RadZoom100" Content="100%" GroupName="pzoom"
                                                     Style="{StaticResource ZoomButton}"
                                                     Checked="ZoomMode_Changed" Margin="4,0,0,0"/>
                                        <RadioButton x:Name="RadZoom200" Content="200%" GroupName="pzoom"
                                                     Style="{StaticResource ZoomButton}"
                                                     Checked="ZoomMode_Changed" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="PreviewArea" Grid.Row="1" Margin="12,0,12,4"
                                        CornerRadius="6" Background="{StaticResource PanelLightBrush}"
                                        Focusable="True" AllowDrop="True"
                                        Drop="Preview_Drop" DragOver="Preview_DragOver"
                                        PreviewKeyDown="Preview_KeyDown"
                                        PreviewMouseWheel="Preview_MouseWheel"
                                        SizeChanged="PreviewArea_SizeChanged">
                                    <Grid>
                                        <ScrollViewer x:Name="PreviewScroll"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto">
                                            <Image x:Name="ImgPreview" Stretch="Uniform"/>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtPreviewHint" Text="Preview appears here"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Margin="12,0,12,10" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}">
                                    <Run Text="Printed size 54 × 86 mm"/>
                                </TextBlock>
                            </Grid>

                            <!-- ===== 2 · PHOTO ===== -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,0,12,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="2 · Photo" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ChkPhoto" Text="  ✓ ready" FontSize="11"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <Border Background="{StaticResource PanelLightBrush}" CornerRadius="6"
                                            Padding="10" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="72" Height="90"
                                                    Background="{StaticResource WhiteBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Image x:Name="ImgPhotoThumb" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtPhotoName" Text="No photo chosen"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <TextBlock x:Name="TxtPhotoMeta" Text=""
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <Button Content="Change…" Click="BrowsePhoto_Click"
                                                        Style="{StaticResource CompactButton}"
                                                        Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Ctrl+O to choose a photo, or drag one onto the preview."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>

                                    <controls:PhotoPositionPanel x:Name="PosPanel" Margin="0,12,0,0"/>

                                    <TextBlock x:Name="TxtPhotoStatus"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== FOOTER: check chips + output + issue ===== -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Background="{StaticResource PanelLightBrush}"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border x:Name="ChipDetails" CornerRadius="10" Padding="10,4"
                                        Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="TxtChipDetails" Text="Details complete"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Border x:Name="ChipUidNew" CornerRadius="10" Padding="10,4"
                                        Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="TxtChipUidNew" Text="Employee ID is new"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Border x:Name="ChipPhoto" CornerRadius="10" Padding="10,4"
                                        Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="TxtChipPhoto" Text="Photo ready"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtStatus" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="380"
                                       Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOutputText" Text="Saves image"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOutputPdf" Text=" + PDF" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnOutputSettings" Content="change in Settings"
                                        Style="{StaticResource GhostButton}" Height="20"
                                        Padding="4,0" FontSize="11" VerticalAlignment="Center"
                                        Click="GoSettings_Click"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtIssueBlocked"
                                       Text="Employee ID already exists. Open the record to re-issue."
                                       FontSize="11" Foreground="{StaticResource ErrorBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       TextWrapping="Wrap" MaxWidth="280" Visibility="Collapsed"
                                       Grid.Column="3"/>
                            <Button x:Name="BtnSave" Content="Issue card" Click="Save_Click"
                                    Style="{StaticResource PrimaryButton}" Height="40"
                                    Margin="14,0,0,0" IsEnabled="False" ToolTip="Ctrl+Enter"
                                    Grid.Column="4" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== BATCH ===== -->
                <Grid x:Name="PageBatch" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="Batch" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtBatchName" Text="Batch" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="TxtBatchCounts" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,4">
                        <RadioButton Content="All" Tag="all" GroupName="BatchFilters" IsChecked="True"
                                     Style="{StaticResource BatchFilterChip}" Checked="BatchFilter_Changed"/>
                        <RadioButton Content="Needs attention" Tag="attention" GroupName="BatchFilters"
                                     Style="{StaticResource BatchFilterChip}" Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                        <RadioButton Content="Ready to review" Tag="review" GroupName="BatchFilters"
                                     Style="{StaticResource BatchFilterChip}" Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                        <RadioButton Content="Re-issues" Tag="reissue" GroupName="BatchFilters"
                                     Style="{StaticResource BatchFilterChip}" Checked="BatchFilter_Changed" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,6">
                        <Button Content="Add row" Click="BatchAddRow_Click" Height="30"/>
                        <Button Content="Duplicate" Click="BatchDupRow_Click" Margin="6,0,0,0" Height="30"/>
                        <Button Content="Paste from Excel" Click="BatchPaste_Click" Margin="6,0,0,0" Height="30"
                                ToolTip="Paste tab or comma separated rows from Excel/CSV"/>
                        <Button Content="Import CSV..." Click="BatchImport_Click" Margin="6,0,0,0" Height="30"/>
                        <Button Content="Export CSV..." Click="BatchExportCsv_Click" Margin="6,0,0,0" Height="30"/>
                        <Button Content="Prepare photos (F5)" Click="StartBatch_Click" x:Name="BtnStartBatch"
                                Margin="14,0,0,0" Height="30"
                                ToolTip="Runs background removal + auto-positioning. Nothing is approved or issued."/>
                        <Button Content="Remove selected (Del)" Click="BatchDelRow_Click" Margin="6,0,0,0" Height="30"/>
                    </StackPanel>
                    <DataGrid x:Name="DgBatch" Grid.Row="3" Margin="8,0,8,0" AutoGenerateColumns="False"
                              RowHeight="40"
                              CanUserAddRows="False" SelectionMode="Single" CellStyle="{StaticResource BatchCell}"
                              HeadersVisibility="Column"
                              CellEditEnding="DgBatch_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="36" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Employee" Width="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                     Background="Transparent" Padding="5,0" FontSize="12"
                                                     VerticalContentAlignment="Center" CaretBrush="{StaticResource TextBrush}"
                                                     KeyDown="BatchText_KeyDown"/>
                                            <TextBlock Text="Full name" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding NameEmpty, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Employee ID" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox x:Name="UidInput"
                                                     Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                     Background="Transparent" Padding="5,0" FontSize="12"
                                                     VerticalContentAlignment="Center" CaretBrush="{StaticResource TextBrush}"
                                                     KeyDown="BatchText_KeyDown"
                                                     LostFocus="BatchUid_LostFocus"/>
                                            <TextBlock Text="Employee ID" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding UidEmpty, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding UidCounterText}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="0,0,7,1"
                                                       Visibility="{Binding IsKeyboardFocused, ElementName=UidInput, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Blood group" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.BloodGroups}}"
                                                  SelectedItem="{Binding Blood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"
                                                  DropDownClosed="BatchCellCombo_Closed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Position" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding Source={x:Static core:Config.Positions}}"
                                                      SelectedItem="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0" Background="Transparent"
                                                      DropDownClosed="BatchCellCombo_Closed"/>
                                            <TextBlock Text="Choose position" Foreground="{StaticResource MutedBrush}"
                                                       FontStyle="Italic" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Margin="6,0,28,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding PositionEmpty, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Contract" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={x:Static core:Config.ContractTypes}}"
                                                  SelectedItem="{Binding Contract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent"
                                                  DropDownClosed="BatchCellCombo_Closed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Print date" Binding="{Binding PrintDateDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Card type" Binding="{Binding CardType}" Width="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Photo" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Browse" Click="BatchBrowse_Click" Padding="8,2"
                                                ToolTip="{Binding PhotoPath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Message}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,6,8,4" VerticalAlignment="Center">
                        <Button Content="Review" Click="BatchReview_Click" x:Name="BtnReview"
                                FontWeight="SemiBold" IsEnabled="False"
                                ToolTip="Open the review screen — approve &amp; issue each card manually."/>
                        <TextBlock x:Name="TxtReviewReason" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                        <Button Content="Cancel" Click="BatchCancel_Click" Margin="14,0,0,0" IsEnabled="False" x:Name="BtnBatchCancel"/>
                        <Button Content="Open output" Click="BatchOpenOutput_Click" Margin="8,0,0,0"/>
                        <ProgressBar x:Name="BatchProgress" Width="200" Height="14" Margin="16,0,0,0"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtBatchStatus" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBatchLog" Grid.Row="5" Margin="8,0,8,6" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" FontSize="11"/>
                </Grid>

                <!-- ===== RECORDS ===== -->
                <Grid x:Name="PageRecords" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,10,14,4">
                        <StackPanel>
                            <TextBlock Text="Records" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Issued cards, reprints, exports, and data tools" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="8,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtSearch" Width="240" ToolTip="Search UID or name (Ctrl+F)"
                                     KeyDown="Search_KeyDown"/>
                            <ComboBox x:Name="CmbContractFilter" Width="120" Margin="8,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Contract type">
                                <ComboBoxItem Content="Any contract"/>
                                <ComboBoxItem Content="Permanent"/>
                                <ComboBoxItem Content="Contractual"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbValidityFilter" Width="130" Margin="6,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Validity">
                                <ComboBoxItem Content="Any validity"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Expires soon"/>
                                <ComboBoxItem Content="Expired"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbIssuedFilter" Width="130" Margin="6,0,0,0"
                                      SelectionChanged="RecordFilter_Changed" ToolTip="Issued date">
                                <ComboBoxItem Content="Any time"/>
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="Last 7 days"/>
                                <ComboBoxItem Content="Last 30 days"/>
                            </ComboBox>
                            <Button Content="Refresh" Click="RefreshRecords_Click" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TxtRecordCount" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="PnlUndo" Visibility="Collapsed" Margin="0,6,0,0" Padding="8,5"
                                CornerRadius="6" Background="{StaticResource PrimaryTintBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock x:Name="TxtUndo" Text="Record deleted" VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Content="Undo" DockPanel.Dock="Right" Padding="12,2"
                                        Click="UndoDelete_Click"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="LstRecords" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  CellStyle="{StaticResource BatchCell}"
                                  SelectionChanged="Record_Selected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee" Binding="{Binding Name}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Employee ID" Binding="{Binding Uid}" Width="100"/>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Contract" Binding="{Binding ContractType}" Width="90"/>
                                <DataGridTextColumn Header="Last issued" Binding="{Binding LastIssued}" Width="115"/>
                                <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntil}" Width="95"/>
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="7,1" HorizontalAlignment="Center"
                                                    Background="{Binding BadgeBrush}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10"
                                                           Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Padding="10"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Height="150" CornerRadius="6" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="ImgRecPreview" Stretch="Uniform" Margin="4"/>
                                        <TextBlock x:Name="TxtRecPreviewEmpty" Text="No card image"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="PnlEditBanner" Grid.Row="1" CornerRadius="6" Margin="0,8,0,0"
                                        Padding="10,7" Visibility="Collapsed"
                                        Background="{StaticResource PrimaryTintBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtEditBanner" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="Re-issue" Click="ReissueBanner_Click"
                                                Margin="10,0,0,0" Padding="12,3"/>
                                    </StackPanel>
                                </Border>
                                <TabControl Grid.Row="2" Margin="0,8,0,0">
                                    <TabItem Header="Details">
                                        <StackPanel x:Name="DtlDetails" Margin="4"/>
                                    </TabItem>
                                    <TabItem Header="Files">
                                        <StackPanel x:Name="DtlFiles" Margin="4"/>
                                    </TabItem>
                                    <TabItem Header="History">
                                        <ListBox x:Name="LstHistory" Margin="4"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,4,8,4" VerticalAlignment="Center">
                        <Button Content="Reprint" Click="Reprint_Click" IsEnabled="False" x:Name="BtnReprint"/>
                        <Button Content="Re-issue" Click="Reissue_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnReissue"/>
                        <Button Content="Edit" Click="EditRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnEditRec"/>
                        <Button Content="Save card as" Click="ExportRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnExportRec"/>
                        <Button Content="Show card file" Click="ShowCardFile_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnShowFile"/>
                        <Button Content="Delete" Click="DeleteRecord_Click" Margin="8,0,0,0" IsEnabled="False" x:Name="BtnDeleteRec"/>
                        <TextBlock x:Name="TxtRecordInfo" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,0,8,8">
                        <Button Content="Export CSV" Click="ExportCsv_Click"/>
                        <Button Content="Export JSON" Click="ExportJson_Click" Margin="6,0,0,0"/>
                        <Button Content="Back up now" Click="BackupDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Restore..." Click="RestoreDb_Click" Margin="6,0,0,0"/>
                        <Button Content="Deleted records..." Click="DeletedRecords_Click" Margin="6,0,0,0"/>
                        <Button Content="Clear all..." Style="{StaticResource DestructiveOutlineButton}" Click="ClearAll_Click" Margin="16,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== SETTINGS ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,20" MaxWidth="720">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Issuing, saved files, and new-card defaults — changes save instantly"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>

                        <GroupBox Header="Issuing" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="SetConfirm" Content="Ask me to confirm before issuing a card"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <CheckBox IsChecked="True" IsEnabled="False" Margin="0,6,0,0"
                                          Foreground="{StaticResource MutedBrush}"
                                          Content="Always confirm re-issues"/>
                                <TextBlock Text="Re-issues always ask for confirmation — this protects against issuing the wrong card twice."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Saved files" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox IsChecked="True" IsEnabled="False" Content="Card image (PNG) — always saved, 300 DPI"/>
                                <CheckBox x:Name="SetPdf" Content="Also save a PDF" Margin="0,6,0,0"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <TextBlock Text="Save cards to" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="TxtSaveFolder" IsReadOnly="True" Width="380"/>
                                    <Button Content="Browse..." Margin="6,0,0,0" Click="BrowseSaveFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="Dates are shown as dd/MM/yyyy" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="New card defaults" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <TextBlock Text="Contract type" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SetContract" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="Print date default" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetPrintDate" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Today"/>
                                </ComboBox>
                                <TextBlock Text="Photo background" Margin="0,10,0,2"/>
                                <ComboBox x:Name="SetBg" Width="220" HorizontalAlignment="Left"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Plain white" Tag="PlainWhite"/>
                                    <ComboBoxItem Content="Model (complex background)" Tag="Model"/>
                                    <ComboBoxItem Content="Keep as is" Tag="Keep"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Backup and restore" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="SetIncludeCards" Content="Include card images"
                                          IsChecked="True" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Back up to file…" Click="BackupToFile_Click"/>
                                    <Button Content="Restore from file…" Click="RestoreFromFile_Click" Margin="8,0,0,0"/>
                                    <Button Content="Open backup folder" Click="OpenBackupFolder_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text=".idbackup files contain the database, photos, and card images. Settings are not included."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelLightBrush}">
            <DockPanel Margin="10,4">
                <StackPanel x:Name="PnlStatusLeft" Orientation="Horizontal" DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  Offline — all data stays on this PC" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusCount" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusBackup" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <StackPanel x:Name="PnlStatusMsg" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtStatusMsg" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text=" | " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtStatusVersion" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="IDForge · Help (F1)"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
