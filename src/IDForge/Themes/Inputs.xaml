<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Text fields, combo boxes, date pickers: 6 px radius, border colour,
         blue focus ring. Red is used only for error states. -->

    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="6" Background="{StaticResource WhiteBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource FocusRingBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputComboBox" TargetType="ComboBox" BasedOn="{StaticResource InputTextBox}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="InputDatePicker" TargetType="DatePicker" BasedOn="{StaticResource InputTextBox}">
        <Setter Property="Height" Value="32"/>
    </Style>
<Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}"/>
    <Style TargetType="DatePicker" BasedOn="{StaticResource InputDatePicker}"/>
</ResourceDictionary>