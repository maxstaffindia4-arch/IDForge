<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UX Pilot colour tokens -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#333333"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PanelLightBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- Status tints at 10% alpha -->
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1A16A34A"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="#1AD97706"/>
    <SolidColorBrush x:Key="ErrorTintBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#1A3B82F6"/>

    <!-- Visual-parity aliases (NEW_CARD_VISUAL_PARITY_PLAN §3.1) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F9FAFB"/>
</ResourceDictionary>
