<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- List and selection chrome: panel-light background, border separators. -->
    <Style x:Key="ThemedListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    </Style>
    <Style x:Key="ThemedListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    </Style>
    <Style x:Key="ThemedListView" TargetType="ListView" BasedOn="{StaticResource ThemedListBox}"/>
<Style TargetType="ListBox" BasedOn="{StaticResource ThemedListBox}"/>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}"/>
    <Style TargetType="ListView" BasedOn="{StaticResource ThemedListView}"/>
</ResourceDictionary>