<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Inter for app UI; JetBrains Mono for IDs/codes. Card render fonts
         (Roboto, Source Sans 3) are loaded by IDForge.Core from disk. -->
    <FontFamily x:Key="AppFontFamily">pack://application:,,,/IDForge;component/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="MonoFontFamily">pack://application:,,,/IDForge;component/Fonts/#JetBrains Mono</FontFamily>
    <!-- Font Awesome 6 Free Solid — UI icons (parity plan §3.3) -->
    <FontFamily x:Key="IconFont">pack://application:,,,/IDForge;component/assets/fonts/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    </Style>
</ResourceDictionary>
